{
  "verbose": false,
  "watch": [
    "src/**/*",
    "public/**/*",
    "unocss/**/*",
    "scripts/**/*",
    "astro.config.mjs",
    "theme.yaml",
    "settings.yaml",
    "uno.config.ts"
  ],
  "ignore": [
    "templates/**/*",
    "public/assets/css/uno.css",
    "public/assets/icons/iconify/**/*"
  ],
  "ext": "astro,vue,html,js,css,svg,yaml,ts,mjs"
}
