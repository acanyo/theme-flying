---
import PageLayout from "../components/layout/PageLayout.astro";
---

<PageLayout
  pageTitle="|${moment.owner?.displayName ?: site.title} 的瞬间 - ${site.title}|"
  pageKind="moment-detail"
  pageUrl="${site.url + '/moments/' + moment.metadata.name}"
  bodyClass="fly-moments fly-moment-detail-page"
>
  <th:block>
    <th:block
      th:replace="~{fragments/moments/detail :: detail(moment=${moment}, commentsEnabled=${haloCommentEnabled})}"
    ></th:block>
  </th:block>
</PageLayout>
