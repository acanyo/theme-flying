---
import PageLayout from "../components/layout/PageLayout.astro";
---

<PageLayout
  pageTitle="|${singlePage.spec.title ?: '所有作者'} - ${site.title}|"
  pageKind="authors"
  pageUrl="${site.url + '/authors'}"
  bodyClass="fly-authors-page"
>
  <th:block
    th:with="authorsPostLimit=${96},recentPostsPage=${postFinder.list({ page: 1, size: authorsPostLimit, sort: {'spec.publishTime,desc'} })},recentPosts=${recentPostsPage?.items},authors=${#sets.toSet(recentPosts.?[owner != null].![owner])}"
  >
    <th:block
      th:replace="~{fragments/authors/shell :: shell(singlePage=${singlePage}, recentPosts=${recentPosts}, authors=${authors})}"
    ></th:block>
  </th:block>
</PageLayout>
