---

---

<html
  lang="zh-CN"
  th:replace="~{fragments/layout :: page(pageTitle=|分类 - ${site.title}|, bodyClass='fly-taxonomy', content=~{::content})}"
>
  <th:block th:fragment="content">
    <div class="fly-content-shell">
      <header class="fly-page-header">
        <p class="fly-eyebrow">浏览</p>
        <h1>分类</h1>
        <p>按主题、目的地和心情浏览文章。</p>
      </header>

      <nav class="fly-taxonomy-grid" aria-label="分类列表">
        <a
          th:each="category : ${categories}"
          class="fly-taxonomy-card"
          th:href="@{${category.status.permalink}}"
        >
          <span th:text="${category.spec.displayName}">分类</span>
          <small th:text="|${category.postCount} 篇文章|">0 篇文章</small>
        </a>
      </nav>
    </div>
  </th:block>

</html>
