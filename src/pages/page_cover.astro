---
import PageLayout from "../components/layout/PageLayout.astro";
---

<PageLayout
  pageTitle="|${singlePage.spec.title} - ${site.title}|"
  pageKind="single-page"
  pageUrl="${#strings.startsWith(singlePage.status.permalink, 'http') ? singlePage.status.permalink : site.url + singlePage.status.permalink}"
  bodyClass="fly-page"
>
  <th:block>
    <th:block
      th:replace="~{fragments/single-page/shell :: shell(singlePage=${singlePage}, pageLayout='cover')}"
    ></th:block>
  </th:block>
</PageLayout>
