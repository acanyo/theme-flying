---

---

<html
  lang="zh-CN"
  th:replace="~{fragments/layout :: page(pageTitle=${site.title}, bodyClass='fly-home', content=~{::content})}"
>
  <th:block th:fragment="content">
    <div
      class="fly-content-shell fly-home-shell"
      th:attr="data-fly-home-layout=${theme.config.basic?.home_layout ?: 'grid'}"
      th:with="homeLayout=${theme.config.basic?.home_layout ?: 'grid'}, categories=${categoryFinder.listAll()}"
    >
      <th:block
        th:replace="~{fragments/home-layouts :: home(posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
      ></th:block>
    </div>
  </th:block>

</html>
