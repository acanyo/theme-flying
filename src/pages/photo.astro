---
import PageLayout from "../components/layout/PageLayout.astro";
---

<PageLayout
  pageTitle="|${photo.spec.displayName ?: '图片'} - ${site.title}|"
  pageKind="photo-detail"
  pageUrl="${site.url + photo.permalink}"
  bodyClass="fly-photo-detail-page"
>
  <th:block>
    <th:block
      th:replace="~{fragments/photos/detail :: detail(photo=${photo}, neighbors=${neighbors}, prev=${prev}, next=${next}, position=${position}, total=${total}, backUrl=${backUrl}, photoUrl=${photoUrl})}"
    ></th:block>
  </th:block>
</PageLayout>
