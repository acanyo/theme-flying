---

---

<html
  lang="zh-CN"
  th:replace="~{fragments/layout :: page(pageTitle=|${singlePage.spec.title} - ${site.title}|, bodyClass='fly-page', content=~{::content})}"
>
  <th:block th:fragment="content">
    <div class="fly-content-shell fly-content-shell--narrow">
      <article class="fly-post-article">
        <header class="fly-post-hero">
          <p class="fly-eyebrow">页面</p>
          <h1 class="fly-post-heading" th:text="${singlePage.spec.title}">
            页面标题
          </h1>
          <footer class="fly-post-meta fly-post-meta--hero">
            <time
              th:datetime="${singlePage.spec.publishTime}"
              th:text="${#dates.format(singlePage.spec.publishTime, 'yyyy-MM-dd')}"
            >
              2026-07-08
            </time>
          </footer>
        </header>

        <section
          class="fly-post-content fly-prose"
          th:utext="${singlePage.content.content}"
        >
        </section>

        <section class="fly-comments-panel" th:if="${haloCommentEnabled}">
          <halo:comment
            group="content.halo.run"
            kind="SinglePage"
            th:attr="name=${singlePage.metadata.name}"></halo:comment>
        </section>
      </article>
    </div>
  </th:block>

</html>
