---

---

<section
  class="fly-topic-section"
  aria-label="精选分类"
  th:fragment="topics(categories, homeLayout)"
  th:if="${not #lists.isEmpty(categories)}"
>
  <th:block
    th:each="category, catIter : ${categories}"
    th:if="${catIter.index < 4}"
    th:with="categoryPosts=${postFinder.list({ page: 1, size: 8, categoryName: category.metadata.name })}"
  >
    <section
      class="fly-topic-block"
      data-fly-carousel
      data-fly-carousel-buttons-only
      th:if="${categoryPosts != null and not #lists.isEmpty(categoryPosts.items)}"
    >
      <header class="fly-topic-header" data-fly-reveal>
        <div>
          <h2>
            <a
              href="/"
              th:href="@{${category.status.permalink}}"
              th:text="${category.spec.displayName}">分类</a
            >
            <span class="fly-topic-marker" aria-hidden="true"></span>
          </h2>
          <p
            th:if="${not #strings.isEmpty(category.spec.description)}"
            th:text="${category.spec.description}"
          >
            分类简介
          </p>
        </div>
        <a
          class="fly-topic-view-link"
          href="/"
          th:href="@{${category.status.permalink}}"
          data-fly-motion-button
        >
          <span class="fly-motion-label">
            <span
              class="fly-motion-label-copy"
              th:text="|查看${category.spec.displayName}|">查看分类</span
            >
            <span
              class="fly-motion-label-copy"
              aria-hidden="true"
              th:text="|查看${category.spec.displayName}|">查看分类</span
            >
          </span>
          <span class="fly-topic-arrow fly-motion-icon" aria-hidden="true"
            >→</span
          >
        </a>
      </header>

      <div
        class="fly-topic-rail"
        data-fly-carousel-rail
        data-fly-reveal-group
        th:id="${'fly-topic-' + category.metadata.name}"
      >
        <th:block th:each="post : ${categoryPosts.items}">
          <div class="fly-topic-slide" data-fly-carousel-item>
            <th:block th:if="${homeLayout == 'grid'}">
              <th:block
                th:replace="~{fragments/home/post-card-overlay :: card(${post})}"
              ></th:block>
            </th:block>
            <th:block th:unless="${homeLayout == 'grid'}">
              <th:block th:replace="~{fragments/post-card :: card(${post})}"
              ></th:block>
            </th:block>
          </div>
        </th:block>
      </div>
      <th:block
        th:replace="~{fragments/home/featured :: carouselControls(label=${category.spec.displayName}, railId=${'fly-topic-' + category.metadata.name})}"
      ></th:block>
    </section>
  </th:block>
</section>
