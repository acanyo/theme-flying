---

---

<article
  class="fly-overlay-post-card"
  th:fragment="card(post)"
  data-fly-post-card
  th:attr="data-fly-post-name=${post.metadata.name},data-fly-category=${not #lists.isEmpty(post.categories) ? post.categories[0].metadata.name : 'uncategorized'},data-fly-title=${post.spec.title},data-fly-excerpt=${post.status.excerpt ?: ''}"
>
  <a
    class="fly-overlay-post-hit"
    href="/"
    th:href="@{${post.status.permalink}}"
    th:attr="aria-label=|阅读：${post.spec.title}|"
  >
    <th:block th:replace="~{fragments/post-cover-media :: badge(post=${post})}"
    ></th:block>
  </a>
  <th:block
    th:replace="~{fragments/post-cover-media :: media(post=${post}, mediaClass=${'fly-overlay-post-image'}, eager=${false})}"
  ></th:block>
  <div class="fly-overlay-post-shade" aria-hidden="true"></div>
  <div class="fly-overlay-post-content">
    <h3>
      <a
        href="/"
        th:href="@{${post.status.permalink}}"
        th:text="${post.spec.title}">文章标题</a
      >
    </h3>
    <div class="fly-overlay-post-meta">
      <th:block
        th:if="${post.owner != null}"
        th:replace="~{fragments/author-popover :: trigger(author=${post.owner}, fallbackPermalink=${post.status.permalink}, variant=${'name'})}"
      ></th:block>
      <span th:unless="${post.owner != null}" th:text="${site.title}">作者</span
      >
      <span aria-hidden="true">·</span>
      <time
        th:datetime="${post.spec.publishTime}"
        th:text="${#dates.format(post.spec.publishTime, 'yyyy年MM月dd日')}"
        >2024年7月11日</time
      >
      <span th:if="${not #lists.isEmpty(post.categories)}" aria-hidden="true"
        >·</span
      >
      <span
        th:if="${not #lists.isEmpty(post.categories)}"
        th:text="${post.categories[0].spec.displayName}">分类</span
      >
    </div>
  </div>
</article>
