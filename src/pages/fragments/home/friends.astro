---

<th:block th:fragment="friends">
  <th:block
    th:if="${pluginFinder.available('PluginLinks') and not #strings.isEmpty(theme.config.basic?.home_link_group)}"
  >
    <th:block
      th:with="friendLinks=${linkFinder.listBy(theme.config.basic.home_link_group)},friendLimit=${8}"
    >
      <section
        class="fly-friends-section"
        aria-labelledby="fly-friends-heading"
        th:if="${not #lists.isEmpty(friendLinks)}"
      >
        <header class="fly-section-heading" data-fly-reveal>
          <h2 id="fly-friends-heading">友情链接</h2>
          <a
            class="fly-section-action"
            href="/links"
            th:href="@{/links}"
            data-fly-motion-button
          >
            <span class="fly-motion-label">
              <span class="fly-motion-label-copy">查看全部</span>
              <span class="fly-motion-label-copy" aria-hidden="true"
                >查看全部</span
              >
            </span>
            <span class="fly-motion-icon" aria-hidden="true">→</span>
          </a>
        </header>

        <div class="fly-friends-grid" data-fly-reveal-group>
          <th:block th:each="link, linkStat : ${friendLinks}">
            <th:block
              th:if="${linkStat.index < friendLimit}"
              th:replace="~{fragments/link-card :: card(link=${link})}"
            ></th:block>
          </th:block>
        </div>
      </section>
    </th:block>
  </th:block>
</th:block>
