---

---

<section
  class="fly-latest-section"
  aria-labelledby="fly-latest-heading"
  aria-busy="false"
  data-fly-feed-region
  th:fragment="feed(posts, homeLayout)"
>
  <header
    class="fly-section-heading"
    data-fly-reveal
    th:classappend="${homeLayout == 'grid' ? ' fly-sr-only' : ''}"
  >
    <h2 id="fly-latest-heading">最新文章</h2>
  </header>

  <th:block
    th:replace="~{fragments/article-feed :: feed(result=${posts}, cardVariant=${homeLayout == 'grid' ? 'overlay' : 'standard'}, feedId=${'fly-latest-feed'}, emptyText=${'当前分类暂无文章，试试其他分类。'}, emptyHidden=${true})}"
  ></th:block>
</section>
