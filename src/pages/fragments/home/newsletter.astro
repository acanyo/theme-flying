---

---

<section class="fly-newsletter-panel" th:fragment="newsletter" data-fly-reveal>
  <div>
    <h2 th:text="|订阅 ${site.title}|">订阅站点</h2>
    <p
      th:if="${not #strings.isEmpty(site.subtitle)}"
      th:text="${site.subtitle}"
    >
      站点副标题
    </p>
  </div>
  <form class="fly-newsletter-form" data-fly-newsletter novalidate>
    <label>
      <span class="fly-sr-only">邮箱地址</span>
      <input
        type="email"
        name="email"
        placeholder="输入邮箱地址..."
        autocomplete="email"
      />
    </label>
    <button class="fly-button fly-button--primary" type="submit"> 订阅 </button>
    <p class="fly-newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>
