---

---

<nav
  class="fly-category-filter fly-horizontal-nav"
  aria-label="文章分类筛选"
  data-fly-category-filter
  th:fragment="categoryFilter(categories)"
>
  <div
    id="fly-category-filter-rail"
    class="fly-category-filter-rail fly-horizontal-nav-rail"
    data-fly-category-filter-rail
  >
    <button
      class="fly-filter-chip fly-horizontal-nav-item fly-is-active"
      type="button"
      data-fly-filter="all"
      aria-pressed="true"
    >
      全部文章
    </button>
    <button
      class="fly-filter-chip fly-horizontal-nav-item"
      type="button"
      data-fly-filter="category"
      aria-pressed="false"
      th:each="category : ${categories}"
      th:attr="data-fly-filter=${category.metadata.name}"
      th:text="${category.spec.displayName}"
    >
      分类
    </button>
  </div>

  <th:block
    th:replace="~{fragments/horizontal-nav-arrow :: arrow(direction=${'prev'}, label=${'向前浏览文章分类'}, railId=${'fly-category-filter-rail'}, controller=${'category-filter'}, modifierClass=${'fly-category-filter-arrow fly-category-filter-arrow--prev'})}"
  ></th:block>
  <th:block
    th:replace="~{fragments/horizontal-nav-arrow :: arrow(direction=${'next'}, label=${'向后浏览文章分类'}, railId=${'fly-category-filter-rail'}, controller=${'category-filter'}, modifierClass=${'fly-category-filter-arrow fly-category-filter-arrow--next'})}"
  ></th:block>
</nav>
