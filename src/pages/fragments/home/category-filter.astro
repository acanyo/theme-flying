---

---

<nav
  class="fly-category-filter"
  aria-label="文章分类筛选"
  data-fly-category-filter
  th:fragment="categoryFilter(categories)"
>
  <div
    id="fly-category-filter-rail"
    class="fly-category-filter-rail"
    data-fly-category-filter-rail
  >
    <button
      class="fly-filter-chip fly-is-active"
      type="button"
      data-fly-filter="all"
      aria-pressed="true"
    >
      全部文章
    </button>
    <button
      class="fly-filter-chip"
      type="button"
      data-fly-filter="category"
      aria-pressed="false"
      th:each="category : ${categories}"
      th:attr="data-fly-filter=${category.metadata.name}"
      th:text="${category.spec.displayName}"
    >
      分类
    </button>
  </div>

  <button
    class="fly-category-filter-arrow fly-category-filter-arrow--prev"
    type="button"
    aria-label="向前浏览文章分类"
    aria-controls="fly-category-filter-rail"
    data-fly-category-filter-prev
    hidden
  >
    <span class="fly-iconify fly-iconify--chevron" aria-hidden="true"></span>
  </button>
  <button
    class="fly-category-filter-arrow fly-category-filter-arrow--next"
    type="button"
    aria-label="向后浏览文章分类"
    aria-controls="fly-category-filter-rail"
    data-fly-category-filter-next
    hidden
  >
    <span class="fly-iconify fly-iconify--chevron" aria-hidden="true"></span>
  </button>
</nav>
