---

---

<th:block
  th:fragment="home(posts, categories, homeLayout, sectionOrder, featuredPostItems)"
>
  <th:block
    th:replace="~{fragments/home/category-filter :: categoryFilter(categories=${categories})}"
  ></th:block>
  <th:block
    th:replace="~{fragments/home/featured :: featured(posts=${posts}, homeLayout=${homeLayout}, featuredPostItems=${featuredPostItems})}"
  ></th:block>

  <th:block th:if="${sectionOrder == null}">
    <th:block
      th:replace="~{fragments/home/home-section :: section(sectionKey='feed', posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/home/home-section :: section(sectionKey='authors', posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/home/home-section :: section(sectionKey='newsletter', posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/home/home-section :: section(sectionKey='topics', posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/home/home-section :: section(sectionKey='friends', posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
    ></th:block>
  </th:block>

  <th:block th:unless="${sectionOrder == null}">
    <th:block th:each="sectionItem : ${sectionOrder}">
      <th:block
        th:if="${sectionItem != null and not #strings.isEmpty(sectionItem['section']) and sectionItem['section'] != 'category_filter' and sectionItem['section'] != 'featured'}"
      >
        <th:block
          th:replace="~{fragments/home/home-section :: section(sectionKey=${sectionItem['section']}, posts=${posts}, categories=${categories}, homeLayout=${homeLayout})}"
        ></th:block>
      </th:block>
    </th:block>
  </th:block>
</th:block>
