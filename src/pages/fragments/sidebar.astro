---

---

<th:block
  th:fragment="sidebar"
  th:with="mainMenuName=${theme.config.navigation?.main_menu ?: ''},
           featureMenuName=${theme.config.navigation?.feature_menu ?: ''},
           footerLinks=${theme.config.navigation?.footer_links},
           tagNames=${theme.config.navigation?.tags},
           socialLinks=${theme.config.navigation?.sidebar_links},
           mainMenu=${#strings.isEmpty(mainMenuName) ? null : menuFinder.getByName(mainMenuName)},
           featureMenu=${#strings.isEmpty(featureMenuName) ? null : menuFinder.getByName(featureMenuName)},
           selectedTags=${#lists.isEmpty(tagNames) ? null : tagFinder.getByNames(tagNames)}"
>
  <aside
    id="fly-site-sidebar"
    class="fly-site-sidebar fly-site-sidebar--static"
    aria-label="站点导航"
  >
    <th:block
      th:replace="~{fragments/sidebar-content :: content(mainMenu=${mainMenu}, featureMenu=${featureMenu}, footerLinks=${footerLinks}, selectedTags=${selectedTags}, socialLinks=${socialLinks})}"
    ></th:block>
  </aside>

  <div
    id="fly-navigation-popup"
    class="fly-navigation-popup"
    data-fly-navigation-popup
    aria-hidden="true"
    inert
  >
    <button
      class="fly-navigation-backdrop"
      type="button"
      data-fly-menu-close
      aria-label="关闭菜单"></button>
    <aside
      class="fly-site-sidebar fly-site-sidebar--popup fly-navigation-panel"
      aria-label="弹出导航"
    >
      <header class="fly-navigation-panel-header">
        <button
          class="fly-icon-button fly-navigation-close"
          type="button"
          data-fly-menu-close
          aria-label="关闭菜单"
        >
          <span class="fly-iconify fly-iconify--close" aria-hidden="true"
          ></span>
        </button>
        <a
          class="fly-brand fly-navigation-brand"
          href="/"
          th:href="@{/}"
          th:text="${site.title}">站点</a
        >
      </header>

      <th:block
        th:replace="~{fragments/sidebar-content :: content(mainMenu=${mainMenu}, featureMenu=${featureMenu}, footerLinks=${footerLinks}, selectedTags=${selectedTags}, socialLinks=${socialLinks})}"
      ></th:block>
    </aside>
  </div>
</th:block>
