---

---

<th:block
  th:fragment="shell(singlePage, recentPosts, authors)"
  th:with="authorLimit=${12}"
>
  <div class="fly-content-shell">
    <div class="fly-authors-page-shell">
      <th:block
        th:replace="~{fragments/authors/hero :: hero(singlePage=${singlePage})}"
      ></th:block>
      <div
        class="fly-authors-directory"
        th:if="${authors != null and not #sets.isEmpty(authors)}"
      >
        <th:block th:each="author, authorStat : ${authors}">
          <th:block
            th:if="${author != null and authorStat.index < authorLimit}"
          >
            <th:block
              th:replace="~{fragments/authors/directory-section :: section(author=${author}, recentPosts=${recentPosts}, index=${authorStat.index})}"
            ></th:block>
          </th:block>
        </th:block>
      </div>
      <p
        class="fly-authors-empty"
        th:if="${authors == null or #sets.isEmpty(authors)}"
      >
        暂无作者。
      </p>
    </div>
  </div>
</th:block>
