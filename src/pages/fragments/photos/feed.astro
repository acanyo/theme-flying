---

<section
  class="fly-photos-feed"
  th:fragment="feed(photos, photoUrl)"
  aria-busy="false"
  data-fly-feed-region
>
  <h2 class="fly-sr-only">图片列表</h2>
  <div
    id="fly-photos-list"
    class="fly-photos-list"
    th:if="${not #lists.isEmpty(photos.items)}"
    data-fly-feed
    data-fly-reveal-group
  >
    <th:block th:each="photo : ${photos.items}">
      <th:block
        th:replace="~{fragments/photos/card :: card(photo=${photo}, photoUrl=${photoUrl})}"
      ></th:block>
    </th:block>
  </div>
  <p
    class="fly-photos-empty"
    th:if="${#lists.isEmpty(photos.items)}"
    data-fly-reveal
  >
    暂无图片。
  </p>
  <th:block
    th:replace="~{fragments/feed-controls :: loadMore(result=${photos}, feedId=${'fly-photos-list'}, autoLoad=${false}, itemSelector=${'[data-fly-photo-name]'}, itemAttribute=${'data-fly-photo-name'}, loadingText=${'正在加载更多图片…'}, loadedUnit=${'张图片'}, endText=${'全部图片已显示'}, appendEvent=${'fly:photos-appended'})}"
  ></th:block>
</section>
