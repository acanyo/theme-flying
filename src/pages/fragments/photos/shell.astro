---

<div
  class="fly-content-shell fly-photos-shell"
  th:fragment="shell(photos, groups, photoUrl, title, description, cover)"
>
  <div class="fly-photos-content">
    <th:block
      th:replace="~{fragments/taxonomy/hero :: hero(title=${title}, description=${description}, imageUrl=${cover}, fallbackImagePath=${'/images/taxonomy-hero.webp'})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/photos/group-filter :: filter(groups=${groups}, photoUrl=${photoUrl})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/photos/feed :: feed(photos=${photos}, photoUrl=${photoUrl})}"
    ></th:block>
  </div>
</div>
