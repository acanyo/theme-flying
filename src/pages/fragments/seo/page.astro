---

---

<th:block
  th:fragment="page(pageKind, pageTitle, pageUrl)"
  th:with="pageName=${pageTitle == site.title ? site.title : #strings.replace(pageTitle, ' - ' + site.title, '')}"
>
  <th:block
    th:if="${pageKind != 'home' and pageKind != 'post' and pageKind != 'tag-detail' and pageKind != 'category-detail' and pageKind != 'author-detail' and pageKind != 'moment-detail' and pageKind != 'photo-detail'}"
  >
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: twoLevel(name=${pageName}, url=${pageUrl})}"
    ></th:block>
  </th:block>

  <th:block th:if="${pageKind == 'post'}">
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: threeLevel(parentName=${theme.config.pages?.archives_title ?: '文章归档'}, parentUrl=${site.url + site.routes.archivesUri}, name=${post.spec.title}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'tag-detail'}">
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: threeLevel(parentName=${theme.config.pages?.tags_title ?: '标签'}, parentUrl=${site.url + site.routes.tagsUri}, name=${tag.spec.displayName}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'category-detail'}">
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: threeLevel(parentName=${theme.config.pages?.categories_title ?: '分类'}, parentUrl=${site.url + site.routes.categoriesUri}, name=${category.spec.displayName}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'author-detail'}">
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: threeLevel(parentName=${'所有作者'}, parentUrl=${site.url + '/authors'}, name=${author.spec.displayName ?: site.title}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'moment-detail'}">
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: threeLevel(parentName=${theme.config.pages?.moments_title ?: '瞬间'}, parentUrl=${site.url + '/moments'}, name=${pageName}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'photo-detail'}">
    <th:block
      th:replace="~{fragments/seo/breadcrumb :: threeLevel(parentName=${theme.config.pages?.photos_title ?: '图库'}, parentUrl=${site.url + '/photos'}, name=${photo.spec.displayName ?: '图片'}, url=${pageUrl})}"
    ></th:block>
  </th:block>

  <th:block th:if="${pageKind == 'archive'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collectionWithCount(name=${theme.config.pages?.archives_title ?: '文章归档'}, description=${theme.config.pages?.archives_description ?: '汇集站点发布的全部文章，涵盖技术、生活与更多主题，在这里按时间探索感兴趣的内容。'}, url=${pageUrl}, itemCount=${archives.total})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'tags'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collection(name=${theme.config.pages?.tags_title ?: '标签'}, description=${theme.config.pages?.tags_description ?: '使用标签探索站点内容。'}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'tag-detail'}">
    <th:block
      th:replace="~{fragments/seo/collection :: term(name=${tag.spec.displayName}, description=${tag.spec.description}, url=${pageUrl}, itemCount=${posts.total})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'categories'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collectionWithCount(name=${theme.config.pages?.categories_title ?: '分类'}, description=${theme.config.pages?.categories_description ?: '按主题浏览内容，发现感兴趣的文章。'}, url=${pageUrl}, itemCount=${#lists.size(categoryFinder.listAll())})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'category-detail'}">
    <th:block
      th:replace="~{fragments/seo/collection :: term(name=${category.spec.displayName}, description=${category.spec.description}, url=${pageUrl}, itemCount=${posts.total})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'authors'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collection(name=${singlePage.spec.title ?: '所有作者'}, description=${singlePage.status.excerpt}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'links'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collectionWithCount(name=${theme.config.pages?.links_title ?: linksTitle}, description=${theme.config.pages?.links_description ?: '发现值得持续关注的网站与创作者，在彼此分享的内容和观点之间建立连接。'}, url=${pageUrl}, itemCount=${#lists.size(links)})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'moments'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collectionWithCount(name=${theme.config.pages?.moments_title ?: '瞬间'}, description=${theme.config.pages?.moments_description ?: '记录生活中的片段、灵感与当下，让轻量的表达也能被认真收藏。'}, url=${pageUrl}, itemCount=${moments.total})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'photos'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collectionWithCount(name=${theme.config.pages?.photos_title ?: '图库'}, description=${theme.config.pages?.photos_description ?: '用影像收藏沿途所见，记录值得反复回看的片刻。'}, url=${pageUrl}, itemCount=${photos.total})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'friends'}">
    <th:block
      th:replace="~{fragments/seo/collection :: collection(name=${theme.config.pages?.friends_title ?: (singlePage.spec.title ?: 'RSS 朋友圈')}, description=${theme.config.pages?.friends_description ?: singlePage.status.excerpt}, url=${pageUrl})}"
    ></th:block>
  </th:block>

  <th:block th:if="${pageKind == 'moment-detail'}">
    <th:block
      th:replace="~{fragments/seo/moment :: posting(moment=${moment}, url=${pageUrl})}"
    ></th:block>
  </th:block>
  <th:block th:if="${pageKind == 'photo-detail'}">
    <th:block
      th:replace="~{fragments/seo/photo :: image(photo=${photo}, url=${pageUrl})}"
    ></th:block>
  </th:block>
</th:block>
