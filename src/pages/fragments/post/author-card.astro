---

---

<section
  class="fly-post-author"
  th:fragment="card(post, variant)"
  th:classappend="${variant == 'compact' ? ' fly-post-author--compact' : ' fly-post-author--desktop'}"
  aria-label="作者信息"
>
  <a
    class="fly-post-author-avatar"
    href="/"
    th:href="@{${post.owner?.permalink ?: post.status.permalink}}"
    th:attr="aria-label=${post.owner?.displayName ?: site.title}"
  >
    <img
      src="/assets/images/avatar.svg"
      th:src="${post.owner?.avatar ?: #theme.assets('/images/avatar.svg')}"
      th:alt="${post.owner?.displayName ?: site.title}"
      alt=""
      loading="lazy"
    />
  </a>

  <h2>
    <a
      href="/"
      th:href="@{${post.owner?.permalink ?: post.status.permalink}}"
      th:text="${post.owner?.displayName ?: site.title}">作者</a
    >
  </h2>

  <p
    class="fly-post-author-bio"
    th:if="${post.owner != null and not #strings.isEmpty(post.owner.bio)}"
    th:text="${post.owner.bio}"
  >
    作者简介
  </p>

  <nav class="fly-post-author-links" aria-label="作者链接">
    <a
      href="/"
      th:href="@{${post.owner?.permalink ?: post.status.permalink}}"
      aria-label="个人网站"
    >
      <span class="fly-iconify fly-iconify--globe" aria-hidden="true"></span>
      <span class="fly-sr-only">个人网站</span>
    </a>
  </nav>
</section>
