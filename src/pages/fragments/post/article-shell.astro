---

---

<article
  class="fly-post-page"
  th:fragment="shell(post, commentsEnabled, layout)"
  th:classappend="| fly-post-page--${layout}|"
  th:attr="data-fly-post-name=${post.metadata.name},data-fly-post-layout=${layout}"
  data-fly-post-page
>
  <th:block
    th:replace="~{fragments/post/header :: header(post=${post}, commentsEnabled=${commentsEnabled}, layout=${layout})}"
  ></th:block>

  <th:block th:if="${layout == 'classic'}">
    <th:block th:replace="~{fragments/post/header :: media(post=${post})}"
    ></th:block>
  </th:block>

  <div class="fly-post-page-grid">
    <th:block th:replace="~{fragments/post/body :: content(post=${post})}"
    ></th:block>
    <th:block th:replace="~{fragments/post/sidebar :: sidebar(post=${post})}"
    ></th:block>
  </div>

  <th:block
    th:replace="~{fragments/post/related :: related(currentPost=${post})}"
  ></th:block>

  <th:block th:replace="~{fragments/post/newsletter :: newsletter}"></th:block>

  <th:block
    th:replace="~{fragments/post/comments :: comments(post=${post}, enabled=${commentsEnabled})}"
  ></th:block>
</article>
