---

---

<th:block th:fragment="related(currentPost)">
  <th:block
    th:with="primaryCategoryName=${not #lists.isEmpty(currentPost.categories) ? currentPost.categories[0].metadata.name : null},primaryTagName=${not #lists.isEmpty(currentPost.tags) ? currentPost.tags[0].metadata.name : null}"
  >
    <th:block
      th:with="categoryResult=${primaryCategoryName != null ? postFinder.list({ page: 1, size: 10, categoryName: primaryCategoryName, sort: {'spec.publishTime,desc'} }) : null}"
    >
      <th:block
        th:with="tagResult=${(categoryResult == null or categoryResult.total <= 1) and primaryTagName != null ? postFinder.list({ page: 1, size: 10, tagName: primaryTagName, sort: {'spec.publishTime,desc'} }) : null}"
      >
        <th:block
          th:with="latestResult=${(categoryResult == null or categoryResult.total <= 1) and (tagResult == null or tagResult.total <= 1) ? postFinder.list({ page: 1, size: 10, sort: {'spec.publishTime,desc'} }) : null}"
        >
          <th:block
            th:with="result=${categoryResult != null and categoryResult.total > 1 ? categoryResult : (tagResult != null and tagResult.total > 1 ? tagResult : (latestResult != null and latestResult.total > 1 ? latestResult : null))}"
          >
            <section
              class="fly-post-related"
              th:if="${result != null and not #lists.isEmpty(result.items)}"
              data-fly-carousel
              role="region"
              aria-roledescription="carousel"
              aria-label="推荐阅读"
              tabindex="0"
            >
              <h2>推荐阅读</h2>

              <div class="fly-post-related-track">
                <div
                  id="fly-post-related-rail"
                  class="fly-post-related-rail"
                  data-fly-carousel-rail
                >
                  <th:block th:each="item : ${result.items}">
                    <th:block
                      th:if="${item.metadata.name != currentPost.metadata.name}"
                    >
                      <th:block
                        th:replace="~{fragments/post/related :: card(item=${item})}"
                      ></th:block>
                    </th:block>
                  </th:block>
                </div>

                <button
                  class="fly-post-related-arrow fly-post-related-arrow--prev"
                  type="button"
                  data-fly-carousel-prev
                  aria-label="上一篇文章"
                  aria-controls="fly-post-related-rail"
                >
                  <span
                    class="fly-iconify fly-iconify--arrow-right"
                    aria-hidden="true"></span>
                </button>
                <button
                  class="fly-post-related-arrow fly-post-related-arrow--next"
                  type="button"
                  data-fly-carousel-next
                  aria-label="下一篇文章"
                  aria-controls="fly-post-related-rail"
                >
                  <span
                    class="fly-iconify fly-iconify--arrow-right"
                    aria-hidden="true"></span>
                </button>
              </div>
            </section>
          </th:block>
        </th:block>
      </th:block>
    </th:block>
  </th:block>
</th:block>

<article
  class="fly-post-related-card"
  th:fragment="card(item)"
  data-fly-carousel-item
  th:with="terms=${not #lists.isEmpty(item.tags) ? item.tags : item.categories}"
>
  <a
    class="fly-post-related-media"
    href="/"
    th:href="@{${item.status.permalink}}"
    th:attr="aria-label=|阅读：${item.spec.title}|"
  >
    <th:block
      th:replace="~{fragments/post-cover-media :: media(post=${item}, mediaClass=${'fly-post-related-image'}, eager=${false})}"
    ></th:block>
    <span class="fly-post-related-read">阅读</span>
  </a>

  <div class="fly-post-related-summary">
    <a
      class="fly-post-related-avatar"
      href="/"
      th:href="@{${item.owner?.permalink ?: item.status.permalink}}"
      th:attr="aria-label=${item.owner?.displayName ?: site.title}"
    >
      <img
        src="/assets/images/avatar.svg"
        th:src="${item.owner?.avatar ?: #theme.assets('/images/avatar.svg')}"
        th:alt="${item.owner?.displayName ?: site.title}"
        alt=""
        loading="lazy"
      />
    </a>
    <div>
      <h3>
        <a
          href="/"
          th:href="@{${item.status.permalink}}"
          th:text="${item.spec.title}">文章标题</a
        >
      </h3>
      <p th:text="${item.owner?.displayName ?: site.title}">作者</p>
      <p class="fly-post-related-meta">
        <time
          th:datetime="${item.spec.publishTime}"
          th:text="${#dates.format(item.spec.publishTime, 'yyyy年M月d日')}"
          >2024年7月11日</time
        >
        <th:block th:if="${not #lists.isEmpty(terms)}">
          <span aria-hidden="true">•</span>
          <span th:text="${terms[0].spec.displayName}">标签</span>
        </th:block>
      </p>
    </div>
  </div>
</article>
