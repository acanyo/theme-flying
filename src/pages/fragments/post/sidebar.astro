---

---

<aside class="fly-post-page-aside" th:fragment="sidebar(post)">
  <th:block
    th:replace="~{fragments/post/author-card :: card(post=${post}, variant='desktop')}"
  ></th:block>

  <div class="fly-post-page-aside-sticky">
    <th:block th:replace="~{fragments/post/toc :: toc}"></th:block>

    <section class="fly-post-sidebar-newsletter" aria-label="订阅邮件">
      <h2>订阅邮件</h2>
      <form
        class="fly-post-sidebar-newsletter-form"
        data-fly-newsletter
        novalidate
      >
        <label>
          <span class="fly-sr-only">邮箱地址</span>
          <input
            type="email"
            name="email"
            placeholder="输入邮箱地址..."
            autocomplete="email"
          />
        </label>
        <button class="fly-button fly-button--primary" type="submit"
          >订阅</button
        >
        <p class="fly-newsletter-status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>
</aside>
