---

---

<aside class="fly-post-page-aside" th:fragment="sidebar(post)">
  <th:block
    th:replace="~{fragments/post/author-card :: card(post=${post}, variant='desktop')}"
  ></th:block>

  <div class="fly-post-page-aside-sticky">
    <th:block th:replace="~{fragments/post/toc :: toc}"></th:block>

    <section
      class="fly-post-sidebar-newsletter"
      th:if="${newsletterEnabled}"
      aria-label="订阅邮件"
    >
      <h2>订阅邮件</h2>
      <th:block
        th:replace="~{fragments/newsletter-form :: form(formClass=${'fly-post-sidebar-newsletter-form'}, label=${''}, labelClass=${''}, controlClass=${'fly-post-sidebar-newsletter-control'})}"
      >
      </th:block>
    </section>
  </div>
</aside>
