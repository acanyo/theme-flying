---

---

<section
  class="fly-post-newsletter-panel"
  th:fragment="newsletter"
  data-fly-post-newsletter
>
  <div>
    <h2>Subscribe to Newsletter</h2>
    <p>
      Join me on this exciting journey as we explore the boundless world of web
      design together.
    </p>
  </div>
  <form class="fly-post-newsletter-form" data-fly-newsletter novalidate>
    <label>
      <span class="fly-sr-only">Email address</span>
      <input
        type="email"
        name="email"
        placeholder="Type your email..."
        autocomplete="email"
      />
    </label>
    <button class="fly-button fly-button--primary" type="submit"
      >Subscribe</button
    >
    <p class="fly-newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>
