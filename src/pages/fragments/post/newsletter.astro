---

---

<section
  class="fly-post-newsletter-panel"
  th:fragment="newsletter"
  data-fly-post-newsletter
>
  <div>
    <h2>订阅邮件</h2>
    <p>订阅更新，及时收到最新文章。</p>
  </div>
  <form class="fly-post-newsletter-form" data-fly-newsletter novalidate>
    <label>
      <span class="fly-sr-only">邮箱地址</span>
      <input
        type="email"
        name="email"
        placeholder="输入邮箱地址..."
        autocomplete="email"
      />
    </label>
    <button class="fly-button fly-button--primary" type="submit">订阅</button>
    <p class="fly-newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>
