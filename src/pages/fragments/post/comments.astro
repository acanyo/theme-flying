---

<section
  id="fly-post-comments"
  class="fly-post-comments"
  th:fragment="comments(post, enabled)"
  th:if="${enabled}"
  aria-labelledby="fly-post-comments-title"
  tabindex="-1"
>
  <div class="fly-post-comments-heading">
    <h2 id="fly-post-comments-title">评论</h2>
    <span
      class="fly-post-comments-count"
      th:if="${post.status.commentsCount != null and post.status.commentsCount > 0}"
      th:text="${post.status.commentsCount}">1</span
    >
  </div>
  <div class="fly-post-comments-body">
    <halo:comment
      group="content.halo.run"
      kind="Post"
      th:attr="name=${post.metadata.name}"></halo:comment>
  </div>
</section>
