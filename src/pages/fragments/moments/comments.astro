---

<section
  id="fly-moment-comments"
  class="fly-post-comments fly-moment-comments"
  th:fragment="comments(moment, enabled)"
  th:if="${enabled}"
  aria-labelledby="fly-moment-comments-title"
  tabindex="-1"
>
  <div class="fly-post-comments-heading">
    <h2 id="fly-moment-comments-title">评论</h2>
    <span
      class="fly-post-comments-count"
      th:if="${moment.stats.approvedComment > 0}"
      th:text="${moment.stats.approvedComment}">1</span
    >
  </div>
  <div class="fly-post-comments-body">
    <halo:comment
      group="moment.halo.run"
      kind="Moment"
      th:attr="name=${moment.metadata.name}"></halo:comment>
  </div>
</section>
