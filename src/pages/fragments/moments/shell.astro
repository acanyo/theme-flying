---

<div
  class="fly-content-shell fly-moments-shell"
  th:fragment="shell(moments, tags, title, description, cover)"
>
  <div class="fly-moments-page">
    <th:block
      th:replace="~{fragments/taxonomy/hero :: hero(title=${title}, description=${description}, imageUrl=${cover}, fallbackImagePath=${'/images/taxonomy-hero.webp'})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/moments/tag-filter :: filter(tags=${tags})}"
    ></th:block>
    <th:block th:replace="~{fragments/moments/feed :: feed(moments=${moments})}"
    ></th:block>
  </div>
</div>
