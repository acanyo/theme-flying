---

---

<footer
  class="fly-moment-meta"
  th:fragment="meta(moment, showDetailLink)"
  th:if="${not #lists.isEmpty(moment.spec.tags) or moment.stats.upvote > 0 or moment.stats.approvedComment > 0 or showDetailLink}"
>
  <div class="fly-moment-tags" th:if="${not #lists.isEmpty(moment.spec.tags)}">
    <a
      th:each="momentTag : ${moment.spec.tags}"
      th:href="@{/moments(tag=${momentTag})}"
      th:text="|#${momentTag}|">#标签</a
    >
  </div>
  <div class="fly-moment-stats">
    <span
      th:if="${moment.stats.upvote > 0}"
      th:text="|${moment.stats.upvote} 赞|">0 赞</span
    >
    <a
      th:if="${moment.stats.approvedComment > 0 and showDetailLink}"
      th:href="@{/moments/{name}(name=${moment.metadata.name})}"
      th:text="|${moment.stats.approvedComment} 评论|">0 评论</a
    >
    <a
      th:if="${moment.stats.approvedComment > 0 and not showDetailLink}"
      href="#fly-moment-comments"
      th:text="|${moment.stats.approvedComment} 评论|">0 评论</a
    >
    <a
      class="fly-moment-detail-link"
      th:if="${showDetailLink}"
      th:href="@{/moments/{name}(name=${moment.metadata.name})}"
      data-fly-motion-button
      ><span class="fly-motion-label">
        <span class="fly-motion-label-copy">查看瞬间</span>
        <span class="fly-motion-label-copy" aria-hidden="true">查看瞬间</span>
      </span>
      <span class="fly-motion-icon" aria-hidden="true">→</span></a
    >
  </div>
</footer>
