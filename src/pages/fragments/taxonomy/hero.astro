---

<section
  class="fly-taxonomy-hero"
  th:fragment="hero(title, description, imageUrl, fallbackImagePath)"
  data-fly-reveal
>
  <div class="fly-taxonomy-hero-copy">
    <h1 th:text="${title}">页面标题</h1>
    <p th:text="${description}">页面简介</p>

    <th:block
      th:if="${theme.config.newsletter?.enabled == null or theme.config.newsletter.enabled}"
      th:replace="~{fragments/newsletter-form :: form(formClass=${'fly-taxonomy-newsletter'}, label=${'订阅更新'}, labelClass=${'fly-taxonomy-newsletter-label'}, controlClass=${'fly-taxonomy-newsletter-control'})}"
    ></th:block>
  </div>

  <div class="fly-taxonomy-hero-media">
    <img
      class="fly-taxonomy-hero-image"
      src="/assets/images/taxonomy-hero.webp"
      th:src="${#strings.isEmpty(imageUrl) ? #theme.assets(fallbackImagePath) : imageUrl}"
      th:alt="${title}"
      alt=""
      width="1600"
      height="900"
    />
  </div>
</section>
