---

<div
  class="fly-content-shell"
  th:fragment="shell(title, description, cover, feedPage, pageSize, pluginAvailable)"
>
  <div
    class="fly-taxonomy-detail fly-friends-detail"
    data-fly-friend-feed-region
    th:attr="data-fly-friend-feed-before-published-at=${feedPage?.nextBeforePublishedAt},data-fly-friend-feed-before-id=${feedPage?.nextBeforeId},data-fly-friend-feed-limit=${pageSize}"
  >
    <th:block
      th:replace="~{fragments/friends/hero :: hero(title=${title}, description=${description}, cover=${cover})}"
    ></th:block>
    <th:block
      th:replace="~{fragments/friends/feed :: feed(feedPage=${feedPage}, pluginAvailable=${pluginAvailable})}"
    ></th:block>
  </div>
</div>
