---

---

<button
  class="fly-carousel-arrow"
  type="button"
  th:fragment="arrow(direction, label, railId, modifierClass)"
  th:classappend="${'fly-carousel-arrow--' + direction + (modifierClass != null and not #strings.isEmpty(modifierClass) ? ' ' + modifierClass : '')}"
  th:attr="aria-label=${label + (direction == 'prev' ? '：上一篇' : '：下一篇')},aria-controls=${railId},disabled=${direction == 'prev' ? 'disabled' : null},data-fly-carousel-prev=${direction == 'prev' ? 'true' : null},data-fly-carousel-next=${direction == 'next' ? 'true' : null}"
>
  <span class="fly-iconify fly-iconify--arrow-right" aria-hidden="true"></span>
</button>
