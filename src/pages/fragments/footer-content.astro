---

---

<div
  class="fly-footer-identity"
  th:fragment="identity(icpBeian, gonganBeian, gonganBeianUrl)"
  th:classappend="${#strings.isEmpty(icpBeian) and #strings.isEmpty(gonganBeian) ? 'fly-footer-identity--copyright-only' : null}"
>
  <div
    class="fly-footer-records"
    aria-label="备案信息"
    th:if="${not #strings.isEmpty(icpBeian) or not #strings.isEmpty(gonganBeian)}"
  >
    <a
      class="fly-footer-record"
      href="https://beian.miit.gov.cn/"
      target="_blank"
      rel="noopener noreferrer"
      th:if="${not #strings.isEmpty(icpBeian)}"
    >
      <img
        class="fly-footer-record-icon"
        src="/assets/images/icp-beian.webp"
        th:src="@{/assets/images/icp-beian.webp}"
        alt=""
        aria-hidden="true"
        width="17"
        height="17"
        loading="lazy"
        decoding="async"
      />
      <span th:text="${icpBeian}">ICP备案号</span>
    </a>
    <a
      class="fly-footer-record"
      href="https://beian.mps.gov.cn/#/query/webSearch"
      target="_blank"
      rel="noopener noreferrer"
      th:if="${not #strings.isEmpty(gonganBeian)}"
      th:href="@{${#strings.isEmpty(gonganBeianUrl) ? 'https://beian.mps.gov.cn/#/query/webSearch' : gonganBeianUrl}}"
    >
      <img
        class="fly-footer-record-icon"
        src="/assets/images/gongan-beian.png"
        th:src="@{/assets/images/gongan-beian.png}"
        alt=""
        aria-hidden="true"
        width="17"
        height="17"
        loading="lazy"
        decoding="async"
      />
      <span th:text="${gonganBeian}">公安备案号</span>
    </a>
  </div>

  <p class="fly-footer-copyright">
    <span class="fly-footer-copyright-site">
      <span
        class="fly-iconify fly-iconify--copyright fly-footer-copyright-icon"
        aria-hidden="true"></span>
      <span th:text="${site.title + '版权所有'}">站点标题版权所有</span>
    </span>
    <span class="fly-footer-copyright-separator" aria-hidden="true">·</span>
    <span class="fly-footer-copyright-credit">
      <span>由</span>
      <a href="https://halo.run/" target="_blank" rel="noopener noreferrer"
        ><strong>Halo</strong></a
      >
      <span>与</span>
      <a
        href="https://github.com/acanyo/theme-flying"
        th:href="${theme.spec.homepage}"
        th:text="${theme.spec.displayName}"
        target="_blank"
        rel="noopener noreferrer">Fly</a
      >
      <span>驱动</span>
    </span>
  </p>
</div>

<nav
  class="fly-footer-navigation"
  aria-label="底部导航"
  th:fragment="navigation(footerLinks, placement)"
  th:classappend="${placement == 'sidebar' ? 'fly-footer-navigation--sidebar' : 'fly-footer-navigation--content'}"
  th:if="${not #lists.isEmpty(footerLinks)}"
>
  <ul>
    <li
      th:each="link : ${footerLinks}"
      th:if="${not #strings.isEmpty(link['label']) and not #strings.isEmpty(link['url'])}"
    >
      <a
        class="fly-footer-link"
        href="/"
        th:href="@{${link['url']}}"
        th:target="${link['new_tab'] == true ? '_blank' : null}"
        th:rel="${link['new_tab'] == true ? 'noopener noreferrer' : null}"
      >
        <span th:text="${link['label']}">导航</span>
      </a>
    </li>
  </ul>
</nav>
