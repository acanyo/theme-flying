---
import PageLayout from "../components/layout/PageLayout.astro";
---

<PageLayout
  pageTitle="|${theme.config.pages?.friends_title ?: (singlePage.spec.title ?: 'RSS 朋友圈')} - ${site.title}|"
  pageKind="friends"
  pageUrl="${#strings.startsWith(singlePage.status.permalink, 'http') ? singlePage.status.permalink : site.url + singlePage.status.permalink}"
  bodyClass="fly-taxonomy fly-friends-page"
>
  <th:block
    th:with="friendsTitle=${theme.config.pages?.friends_title ?: (singlePage.spec.title ?: 'RSS 朋友圈')}, friendsDescription=${theme.config.pages?.friends_description ?: (singlePage.status.excerpt ?: '')}, friendsCover=${theme.config.pages?.friends_cover ?: (singlePage.spec.cover ?: '')}"
  >
    <th:block
      th:replace="~{fragments/friends/page :: page(title=${friendsTitle}, description=${friendsDescription}, cover=${friendsCover})}"
    ></th:block>
  </th:block>
</PageLayout>
