---
import PageLayout from "../components/layout/PageLayout.astro";

---

<PageLayout
  pageTitle="|${post.spec.title} - ${site.title}|"
  pageKind="post"
  pageUrl="${#strings.startsWith(post.status.permalink, 'http') ? post.status.permalink : site.url + post.status.permalink}"
  bodyClass="fly-post"
>
  <th:block th:with="articleLayout=${'split'}">
    <th:block
      th:replace="~{fragments/post/article-shell :: shell(post=${post}, commentsEnabled=${haloCommentEnabled}, layout=${articleLayout})}"
    ></th:block>
  </th:block>

</PageLayout>
