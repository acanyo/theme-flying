---
const thymeleafLanguage = { "th:lang": "${#locale.toLanguageTag}" };
---

<!doctype html>
<html
  {...thymeleafLanguage}
  class="fly-auth-root"
  data-theme="light"
  th:fragment="layout (title,head,body)"
  th:with="authHeading=${#strings.contains(title, ' - ') ? #strings.substringBefore(title, ' - ') : title},isLogout=${#strings.contains(authHeading, '退出登录')},isLogin=${not isLogout and #strings.contains(authHeading, '登录')},isSignup=${#strings.contains(authHeading, '注册')},authDescription=${isLogout ? '确认退出当前账号？退出后仍可继续浏览公开内容，需要互动时可随时重新登录。' : (isLogin ? '欢迎回来！登录后即可访问专属内容、参与社区互动，并在丰富的文章分类中继续探索。' : (isSignup ? '加入社区，创建账号后即可收藏内容、参与互动，并发现更多感兴趣的文章与作者。' : '请按照页面提示完成账户验证与安全操作。'))},authBackground=${theme.config.auth?.cover ?: (theme.config.pages?.auth_cover ?: '')},primaryColor=${theme.config.style?.primary_color ?: '#000000'},secondaryColor=${theme.config.style?.secondary_color ?: '#ededed'}"
  th:style="|--fly-primary-color:${primaryColor};--fly-secondary-color:${secondaryColor};--fly-primary-color-dark:${primaryColor == '#000000' ? '#ffffff' : primaryColor};--fly-secondary-color-dark:${secondaryColor == '#000000' ? '#ffffff' : secondaryColor}|"
>
  <head>
    <meta charset="UTF-8" />
    <meta content="IE=edge" http-equiv="X-UA-Compatible" />
    <meta content="webkit" name="renderer" />
    <meta
      content="width=device-width, initial-scale=1, viewport-fit=cover"
      name="viewport"
    />
    <meta content="noindex,nofollow" name="robots" />
    <title th:text="${title}">账户</title>
    <meta
      name="fly-gateway-resources"
      th:replace="~{gateway_fragments/common::basicStaticResources}"
    />
    <script is:inline>
      (function applyAuthTheme() {
        var storedTheme = null;
        try {
          storedTheme = localStorage.getItem("flying-theme");
        } catch (error) {
          storedTheme = null;
        }

        var preference =
          storedTheme === "dark" ||
          storedTheme === "light" ||
          storedTheme === "system"
            ? storedTheme
            : "system";
        var prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme =
          preference === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : preference;
      })();
    </script>
    <link
      rel="stylesheet"
      href="/assets/css/uno.css?v=1.0.217"
      th:href="@{/assets/css/uno.css(v=${theme.spec.version},fly='1.0.217')}"
    />
  </head>
  <body
    class="gateway-page fly-auth-page"
    th:classappend="${isLogout ? 'fly-auth-page--logout' : (isLogin ? 'fly-auth-page--login' : (isSignup ? 'fly-auth-page--signup' : ''))}"
  >
    <th:block th:if="${head != null}">
      <th:block th:replace="${head}"></th:block>
    </th:block>
    <main
      class="fly-auth-shell"
      data-fly-auth
      data-fly-social-fallback-icon="/assets/icons/iconify/fingerprint.svg"
      th:data-fly-social-fallback-icon="${#theme.assets('/icons/iconify/fingerprint.svg')}"
    >
      <figure class="fly-auth-cover" aria-hidden="true">
        <img
          src="/assets/images/archive-hero.webp"
          alt=""
          th:src="${#strings.isEmpty(authBackground) ? #theme.assets('/images/archive-hero.webp') : authBackground}"
          width="1600"
          height="900"
          decoding="async"
          fetchpriority="high"
        />
      </figure>

      <section class="fly-auth-panel">
        <a class="fly-auth-back" href="/" th:href="@{/}">
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M15.8333 10.0001H4.16666M4.16666 10.0001L9 5.16675M4.16666 10.0001L9 14.8334"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>返回首页</span>
        </a>

        <div class="fly-auth-main-content">
          <header class="fly-auth-intro">
            <h1 th:text="${authHeading}">账户</h1>
            <p th:text="${authDescription}">
              请按照页面提示完成账户验证与安全操作。
            </p>
          </header>

          <div class="fly-auth-native">
            <th:block th:replace="${body}"></th:block>
          </div>
        </div>

        <footer
          class="fly-auth-footer"
          th:with="icpBeian=${theme.config.basic?.icp_beian ?: ''},
                   gonganBeian=${theme.config.basic?.gongan_beian ?: ''},
                   gonganBeianUrl=${theme.config.basic?.gongan_beian_url ?: ''}"
        >
          <th:block
            th:replace="~{fragments/footer-content :: identity(icpBeian=${icpBeian}, gonganBeian=${gonganBeian}, gonganBeianUrl=${gonganBeianUrl})}"
          ></th:block>
        </footer>
      </section>
    </main>

    <script
      is:inline
      type="module"
      src="/assets/js/modules/auth-page.js?v=1.0.8"
      th:src="@{/assets/js/modules/auth-page.js(v=${theme.spec.version},fly='1.0.8')}"
    ></script>
  </body>
</html>
