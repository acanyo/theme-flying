---
import PageLayout from "../components/layout/PageLayout.astro";
---

<PageLayout
  pageTitle="|${author.spec.displayName ?: site.title} - ${site.title}|"
  pageKind="author-detail"
  pageUrl="${site.url + '/authors/' + author.metadata.name}"
  bodyClass="fly-author fly-author--detail"
>
  <th:block>
    <div class="fly-content-shell">
      <div class="fly-author-detail" data-fly-feed-region>
        <th:block
          th:replace="~{fragments/author-detail/profile-hero :: profile(author=${author}, posts=${posts})}"
        ></th:block>
        <th:block
          th:replace="~{fragments/author-detail/posts :: posts(result=${posts})}"
        ></th:block>
      </div>
    </div>
  </th:block>
</PageLayout>
